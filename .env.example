# Server-only Supabase project configuration. Copy real values into private .env.
# Use the same project for Auth, PostgreSQL and Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Public Cloudflare Turnstile site key. Matching secret stays in Supabase Auth.
AUTH_CAPTCHA_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_DB_CA_FILE=
# Restore the existing 32-byte key when recovering data; do not replace it.
MARKET_ORDER_PIN_KEY_FILE=

# Loopback application port. Retained name for existing local configuration.
PINEVELA_MIGRATION_PORT=3001
# Set the actual HTTPS origin when deploying behind a reverse proxy.
PINEVELA_PUBLIC_ORIGIN=
# Trust only the actual proxy IPs/CIDRs; leave blank for direct local access.
PINEVELA_TRUST_PROXY=
# Serve the verified build during local development instead of Vite/HMR.
PINEVELA_MIGRATION_STATIC_PREVIEW=false

# Enable Confirm email and configure SMTP/Google in Supabase Auth.
# Local development may enroll a separate genuinely verified Google manager.
# This opt-in requires loopback, non-production mode and no public origin.
PINEVELA_DEV_GOOGLE_MANAGER_ENROLLMENT=false

# Keep destructive execution gates off unless following the reviewed native workflow.
PINEVELA_RESIDENCE_EXECUTION_REQUESTS=false
PINEVELA_SYSTEM_WIPE_EXECUTION_REQUESTS=false

# Server-only existing Paystack configuration. Never use a VITE_ key.
PAYSTACK_SECRET_KEY=
# Hosted checkout uses PINEVELA_PUBLIC_ORIGIN configured above.
# Optional Photon-compatible place endpoints. Defaults support search as you type;
# public Nominatim must not be used for autocomplete.
PINEVELA_PLACE_SEARCH_URL=https://photon.komoot.io/api/
PINEVELA_PLACE_REVERSE_URL=https://photon.komoot.io/reverse
# Customer-service replies (server only; configure a verified Resend sender).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Server-only automatic marketplace/profile moderation. Never use a VITE_ key.
OPENAI_API_KEY=
# Server-only companion inference. Choose a provider explicitly; no paid fallback.
COMPANION_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Retained for the legacy Groq configuration and its private diagnostic.
GROQ_API_KEY=
