ADMIN_DESTRUCTIVE_PASSWORD_HASH=
ADMIN_DESTRUCTIVE_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ADMIN_USERNAME=
GEMINI_API_KEY=
# Supabase Auth signup confirmation (public anon/publishable key, never a service-role key).
# Enable Confirm email. Built-in confirmation links work; custom templates can also use {{ .Token }}.
# Configure delivery/Resend SMTP in Supabase, not in application authentication code.
SUPABASE_ANON_KEY=
SUPABASE_URL=
PINEVELA_DATA_DIR=

# Temporary signup codes: opt-in only for localhost requests to the TypeScript dev server.
# Built/production servers ignore this switch; turn it off when using real Supabase email.
PINEVELA_DEV_SIGNUP_CODES=false

# Absolute server session lifetime (60–604800 seconds; default: one day).
PINEVELA_SESSION_TTL_SECONDS=86400
# Set the public HTTPS origin in production for cookie write origin checks.
PINEVELA_PUBLIC_ORIGIN=

# Optional image storage location and distinct media origin (reverse proxy /uploads there).
# When using MEDIA_ORIGIN, also set PUBLIC_ORIGIN; both must use HTTPS in production.
PINEVELA_UPLOADS_DIR=
PINEVELA_MEDIA_ORIGIN=

# Leave blank for direct/local access. Behind a proxy, list ONLY its actual IPs/CIDRs.
# Forwarded client IP headers are ignored from every other address; blanket trust is rejected.
PINEVELA_TRUST_PROXY=
